generator client {
  provider = "prisma-client-js"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String       @id @default(cuid())
  email       String       @unique
  username    String       @unique
  name        String?
  avatarData  Bytes?       @db.ByteA
  avatarMimeType String?
  preferredLanguage String?
  preferredExplanationStyle String?
  dailyBudgetUsd Float?
  passwordHash String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  experiments Experiment[]
  refreshTokens RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  promptTemplates PromptTemplate[]
  connectedProviders ConnectedProvider[]
  chats       Chat[]
  documents   WorkspaceDocument[]
  workspaces  Workspace[]
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  systemPrompt String? @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chats     Chat[]
  documents WorkspaceDocument[]

  @@unique([userId, name])
  @@index([userId, updatedAt])
}

model ConnectedProvider {
  id             String   @id @default(cuid())
  provider       String
  displayName    String
  encryptedApiKey String?
  baseUrl        String?
  defaultModel   String?
  contextLength  Int?
  strengths      String?  @db.Text
  weaknesses     String?  @db.Text
  inputPricePerMillion Float?
  outputPricePerMillion Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  runs           ExperimentRun[]
  chats          Chat[]

  @@unique([userId, provider, displayName])
  @@index([userId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Experiment {
  id          String   @id @default(cuid())
  name        String
  description String?
  modelName   String   @default("not-configured")
  status      String   @default("draft")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  runs ExperimentRun[]

  @@index([createdAt])
  @@index([status])
}

model Chat {
  id                   String   @id @default(cuid())
  title                String   @default("New chat")
  modelName            String?
  memoryEnabled        Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId          String?
  workspace            Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  providerConnectionId String?
  providerConnection   ConnectedProvider? @relation(fields: [providerConnectionId], references: [id], onDelete: SetNull)
  messages             ChatMessage[]

  @@index([userId, updatedAt])
  @@index([workspaceId, updatedAt])
}

model ChatMessage {
  id         String   @id @default(cuid())
  role       String
  content    String?  @db.Text
  status     String   @default("completed")
  modelName  String?
  durationMs Int?
  estimatedCostUsd Float?
  sources    Json?
  createdAt  DateTime @default(now())
  chatId     String
  chat       Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId, createdAt])
}

model WorkspaceDocument {
  id        String   @id @default(cuid())
  name      String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String?
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([userId, updatedAt])
  @@index([workspaceId, updatedAt])
}

model ExperimentRun {
  id         String   @id @default(cuid())
  prompt     String   @db.Text
  response   String?  @db.Text
  modelName  String
  temperature Float  @default(0.7)
  topP       Float   @default(0.9)
  maxTokens  Int     @default(256)
  frequencyPenalty Float @default(0)
  presencePenalty  Float @default(0)
  precisionScore   Int?
  concisenessScore Int?
  status     String   @default("pending")
  error      String?  @db.Text
  durationMs Int?
  estimatedCostUsd Float?
  createdAt  DateTime @default(now())

  experimentId String
  experiment   Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  providerConnectionId String?
  providerConnection   ConnectedProvider? @relation(fields: [providerConnectionId], references: [id], onDelete: SetNull)
  promptVersionId String?
  promptVersion   PromptVersion? @relation(fields: [promptVersionId], references: [id], onDelete: SetNull)

  @@index([experimentId, createdAt])
  @@index([promptVersionId])
  @@index([providerConnectionId])
  @@index([status])
}

model PromptTemplate {
  id        String   @id @default(cuid())
  title     String
  prompt    String   @db.Text
  category  String   @default("General")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  versions PromptVersion[]

  @@index([category])
  @@index([createdAt])
  @@index([userId])
}

model PromptVersion {
  id               String         @id @default(cuid())
  promptTemplateId String
  version          Int
  title            String
  prompt           String         @db.Text
  category         String
  createdAt        DateTime       @default(now())
  promptTemplate   PromptTemplate @relation(fields: [promptTemplateId], references: [id], onDelete: Cascade)
  runs             ExperimentRun[]

  @@unique([promptTemplateId, version])
  @@index([promptTemplateId, createdAt])
}
