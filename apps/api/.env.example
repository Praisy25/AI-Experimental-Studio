DATABASE_URL="postgresql://aistudio:local_dev_password@localhost:5432/ai_experiment_studio?schema=public"
PORT=4000
WEB_ORIGIN="http://localhost:3000"
# Use a randomly generated secret of at least 32 bytes in production.
AUTH_SECRET="replace-with-a-long-random-secret-before-deploying"
# Configure SMTP to enable password reset emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Generate a random 32-byte key and base64-encode it; keep it secret and back it up.
ENCRYPTION_KEY=replace-with-a-random-base64-encoded-32-byte-key
# Free local mode is the default. Set true only when you intentionally want to enable external API calls.
ALLOW_EXTERNAL_AI=false
