        <mxCell id="title" value="AI Experiment Studio — System Architecture" style="text;html=1;align=center;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#172033" vertex="1" parent="1"><mxGeometry x="390" y="35" width="820" height="50" as="geometry"/></mxCell>
        <mxCell id="user" value="&lt;b&gt;User&lt;/b&gt;&lt;br&gt;Browser&lt;br&gt;&lt;font color=&quot;#64748b&quot;&gt;Sends prompts&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontSize=16;arcSize=8" vertex="1" parent="1"><mxGeometry x="55" y="210" width="180" height="132" as="geometry"/></mxCell>
